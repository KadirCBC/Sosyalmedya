# ==============================================================================
# Plesk / Nginx Optimize Edilmiş Yapılandırma Dosyası
# Plesk Panel > Alan Adınız > Apache & Nginx Settings > Additional nginx directives
# ==============================================================================

# 1. Document Root'un /public klasörünü gösterdiğinden emin olun
# root /var/www/vhosts/alanadiniz.com/httpdocs/public;

# 2. Sanctum Authorization Header Geçirgenliği
fastcgi_pass_request_headers on;

# 3. Güvenlik Başlıkları
add_header X-Frame-Options "SAMEORIGIN" always;
add_header X-Content-Type-Options "nosniff" always;
add_header X-XSS-Protection "1; mode=block" always;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;

# 4. Ana İstek Yönlendirmesi
location / {
    try_files $uri $uri/ /index.php?$query_string;
}

# 5. Server-Sent Events (SSE) Anlık Bildirim Akışı Optimizasyonu
# Tamponlamayı (buffering) kapatır, anlık bildirimlerin beklemeden istemciye ulaşmasını sağlar
location /api/v1/notifications/stream {
    proxy_buffering off;
    proxy_cache off;
    proxy_set_header Connection '';
    proxy_http_version 1.1;
    chunked_transfer_encoding off;
    proxy_read_timeout 120s;
    fastcgi_buffering off;
    fastcgi_read_timeout 120s;
    try_files $uri /index.php?$query_string;
}

# 6. Kritik Dosyaları ve Dizinleri Gizle (404 / 403)
location ~ /\.(env|git|ht|yml) {
    deny all;
    return 404;
}

location ~ /(storage/logs|bootstrap/cache|vendor) {
    deny all;
    return 404;
}

# 7. Statik Varlıklar İçin Tarayıcı Önbellekleme (Görseller Cloudflare R2'de olsa bile yerel assetler için)
location ~* \.(jpg|jpeg|png|gif|ico|css|js|webp|svg|woff|woff2|ttf)$ {
    expires 365d;
    add_header Cache-Control "public, no-transform";
    access_log off;
}

