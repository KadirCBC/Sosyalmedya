APP_NAME=SosyalMedya
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Europe/Istanbul
APP_URL=https://example.com

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sosyalmedya
DB_USERNAME=root
DB_PASSWORD=

# Media Storage (Cloudflare R2 - S3 Compatible)
FILESYSTEM_DISK=r2
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=social-media-bucket
R2_URL=https://pub-your-id.r2.dev
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_USE_PATH_STYLE_ENDPOINT=false

# SMS Gateway (Netgsm / Log)
SMS_DRIVER=netgsm
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_HEADER=
NETGSM_ENDPOINT=https://api.netgsm.com.tr/sms/send/xml
NETGSM_TIMEOUT=10

# Cache & Session (cPanel/Plesk için redis veya file)
CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=database

# WebPush / PWA VAPID Keys
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
